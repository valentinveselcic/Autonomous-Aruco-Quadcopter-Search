<launch>
    <let name="rviz_config_path" 
        value="$(find-pkg-share tello_bringup)/config/rviz.rviz" />
    <let name="aruco_config_path" 
        value="$(find-pkg-share tello_bringup)/config/aruco_markers_tello.yaml" />
    <let name="camera_info_path" 
        value="$(find-pkg-share tello)/resource/ost.yaml" />

    <node pkg="tello" exec="tello_node_tc">
        <param name="connect_timeout" value="15.0"/>
        <param name="tello_ip" value="192.168.10.1"/>
        <param name="tf_base" value="odom"/>
        <param name="tf_drone" value="drone"/>
        <param name="camera_info_file" value="$(var camera_info_path)"/>
    </node>

    <node pkg="rviz2" exec="rviz2" />

</launch>